{
  "name": "auralith-studio",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Auralith Studio — lokalne studio afirmacji i subliminali",
  "author": "piotrkolodz",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build-model.cjs && vite build",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "package": "npm run build && electron-builder --win portable nsis"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.577.0",
    "motion": "^13.2.0",
    "node-edge-tts": "1.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.58.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "6.4.3"
  },
  "build": {
    "appId": "studio.auralith.desktop",
    "productName": "Auralith Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "vendor/FFmpeg-LICENSE.txt",
        "to": "licenses/FFmpeg-LICENSE.txt"
      },
      {
        "from": "vendor/FFmpeg-README.txt",
        "to": "licenses/FFmpeg-README.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Auralith-Studio-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Auralith-Studio-${version}-${arch}-Portable.${ext}"
    },
    "asarUnpack": [
      "desktop/speak.ps1"
    ],
    "compression": "normal",
    "publish": [
      {
        "provider": "github",
        "owner": "crxptt1",
        "repo": "Auralith",
        "releaseType": "release"
      }
    ]
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/crxptt1/Auralith.git"
  }
}
